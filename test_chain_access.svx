tip Point {
    i32 x = 0;
    i32 y = 0;
}

tip Rect {
    Point top_left = { x = 1; y = 2; };
    Point bottom_right = { x = 3; y = 4; };
}

svi tip Rect lor rect = {
    top_left = { x = 1; y = 2; },
    bottom_right = { x = 3; y = 4; }
};

slov(rect.top_left.x);
slov(rect.top_left.y);
slov(rect.bottom_right.x);
slov(rect.bottom_right.y);

// Дополнительные тесты вложенного доступа
tip Inner {
    i32 val = 0;
}
tip Outer {
    Inner inner = { val = 42 };
}
svi tip Outer lor outer;
slov(outer.inner.val);

// Цепной доступ через именованные поля
tip A {
    i32 x = 0;
}
tip B {
    A a = { x = 5 };
}
tip C {
    B b = { a = { x = 7 } };
}
svi tip C lor c;
slov(c.b.a.x);