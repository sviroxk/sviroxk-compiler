struct Point {
    i32 x = 0;
    i32 y = 0;
}

struct Rect {
    Point top_left = { x = 1; y = 2; };
    Point bottom_right = { x = 3; y = 4; };
}

Rect rect = {
    top_left = { x = 1; y = 2; },
    bottom_right = { x = 3; y = 4; }
};

print(rect.top_left.x);
print(rect.top_left.y);
print(rect.bottom_right.x);
print(rect.bottom_right.y);

// Дополнительные тесты вложенного доступа
struct Inner {
    i32 val = 0;
}
struct Outer {
    Inner inner = { val = 42 };
}
Outer outer;
print(outer.inner.val);

// Цепной доступ через именованные поля
struct A {
    i32 x = 0;
}
struct B {
    A a = { x = 5 };
}
struct C {
    B b = { a = { x = 7 } };
}
C c;
print(c.b.a.x);