struct Point {
    i32 x = 0;
    i32 y = 0;
}

struct Rect {
    Point top_left = { x = 1; y = 2; };
    Point bottom_right = { x = 3; y = 4; };
}

Rect rect = {
    top_left = { x = 1; y = 2; },
    bottom_right = { x = 3; y = 4; }
};

print(rect.top_left.x);
print(rect.top_left.y);
print(rect.bottom_right.x);
print(rect.bottom_right.y);