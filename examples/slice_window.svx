// Окно на часть массива (срез, D-018): функция читает и меняет кусок без копии,
// массив остаётся у вызывающего. Две записи окна и две записи среза — одно и то же.
struct Person { string name; int age = 0; }

fn int sum(int[..] part) {
    int s = 0;
    for i in 0..part.len() { s += part[i]; }
    return s;
}

fn void twice(slice int[] part) {
    for i in 0..part.len() { part[i] = part[i] * 2; }
}

fn int tail_sum(int[..] part) { return sum(part[1..part.len()]); }

fn int[] keep(int[..] part) { return part; }  // своя копия части

fn int oldest(Person[..] people) {
    int best = 0;
    for i in 0..people.len() {
        if (people[i].age > best) { best = people[i].age; }
    }
    return best;
}

int[] v = [1, 2, 3, 4, 5];
print(sum(v[1..4]));
print(sum(slice(v, 1, 3)));
print(sum(v));
twice(v[0..2]);
print(v[0]);
print(v[1]);
print(v[2]);
print(tail_sum(v));
int[] c = keep(v[3..5]);
c.push(9);
print(c.len());
print(v.len());

int[] d = new int[0];
for i in 1..5 { d.push(i * 10); }
print(sum(d[2..4]));
twice(slice(d, 0, 1));
print(d[0]);
print(sum(d[2..2]));

Person[] people = new Person[0];
Person ann;
ann.name = "Ann";
ann.age = 30;
people.push(ann);
Person bob;
bob.name = "Bob";
bob.age = 41;
people.push(bob);
print(oldest(people));
print(oldest(slice(people, 0, 1)));
