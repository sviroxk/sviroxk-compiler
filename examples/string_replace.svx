let replaced: ptr = replace("before needle after", "needle", "FOUND");
print(replaced);
del replaced;

let unchanged: ptr = replace("plain text", "missing", "FOUND");
print(unchanged);
del unchanged;

let long_source: ptr = replace("", "nop", "replacement");
print(long_source);
del long_source;

let long_replaced: ptr = replace("", "mnop", "WXYZ");
print(long_replaced);
del long_replaced;
